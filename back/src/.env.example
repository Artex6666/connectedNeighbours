PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/bobconnect

# Neo4j
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# JWT
JWT_SECRET=changeme_use_a_long_random_string
JWT_REFRESH_SECRET=changeme_refresh_use_a_different_string

# MFA
MFA_ISSUER=BobConnect

# Email (Brevo SMTP relay). Si SMTP_HOST est vide, l'envoi est ignoré (no-op).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxxxx@smtp-brevo.com
# SMTP_PASS : la clé SMTP Brevo (master password, format "xsmtpsib-...")
SMTP_PASS=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Expéditeur affiché — doit être un expéditeur/domaine validé dans Brevo
MAIL_FROM_NAME=BobConnect
MAIL_FROM=no-reply@example.com

# Env
NODE_ENV=development
